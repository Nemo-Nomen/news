<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.axelnews.weeklyhistory</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/axel/Documents/Axel News/.venv/bin/python3</string>
        <string>/Users/axel/Documents/Axel News/src/build_weekly_history_snapshot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/axel/Documents/Axel News</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/axel/Documents/Axel News/logs/weekly_history.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/axel/Documents/Axel News/logs/weekly_history_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
